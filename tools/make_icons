#!/usr/bin/env bash
# Renders the icons (tools/art/*.svg, white silhouettes) to Media/<Name>.tga.
# Needs rsvg-convert and Python with Pillow.
set -eu
HERE="$(cd "$(dirname "$0")/.." && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
for svg in "$HERE"/tools/art/*.svg; do
    name="$(basename "$svg" .svg)"
    rsvg-convert "$svg" -o "$TMP/$name.png"
    python3 -c 'import sys; from PIL import Image; Image.open(sys.argv[1]).convert("RGBA").save(sys.argv[2])' \
        "$TMP/$name.png" "$HERE/Media/$name.tga"
done
